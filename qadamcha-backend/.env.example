# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/qadamcha?retryWrites=true&w=majority
REDIS_URL=redis://default:password@redis-host:port

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-secure-jwt-secret-here

# Eskiz SMS (https://eskiz.uz)
ESKIZ_EMAIL=your_email@gmail.com
ESKIZ_PASSWORD=your_eskiz_api_password

# Bunny.net (Video CDN)
BUNNY_STREAM_LIBRARY_ID=your_library_id
BUNNY_STREAM_API_KEY=your_api_key
BUNNY_CDN_HOSTNAME=vz-xxxxx.b-cdn.net

# Gemini AI (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Payme (https://merchant.paycom.uz)
PAYME_MERCHANT_ID=your_merchant_id
PAYME_KEY=your_merchant_key
PAYME_CHECKOUT_URL=https://test.paycom.uz

# Sentry (Error Monitoring — optional)
SENTRY_DSN=

# Firebase (Push Notifications — base64 encoded service account JSON)
FIREBASE_SERVICE_ACCOUNT=
