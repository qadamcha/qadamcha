# =================================
# Qadamcha Backend - Environment Variables
# =================================
# Bu faylni .env deb nomlang va qiymatlarni to'ldiring
# cp .env.example .env

# Server
PORT=3000
NODE_ENV=development

# Database (MongoDB Atlas dan oling: https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/qadamcha?retryWrites=true&w=majority

# Redis (Redis Cloud dan oling: https://app.redislabs.com)
REDIS_URL=redis://default:PASSWORD@redis-xxxxx.xxxx.ec2.cloud.redislabs.com:xxxxx

# JWT Secret (kamida 32 ta belgi, random bo'lishi kerak)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Eskiz SMS (https://eskiz.uz dan ro'yxatdan o'ting)
ESKIZ_EMAIL=your_email@gmail.com
ESKIZ_PASSWORD=your_eskiz_api_password

# Bunny.net (https://bunny.net dan oling)
BUNNY_STREAM_LIBRARY_ID=your_library_id
BUNNY_STREAM_API_KEY=your_bunny_api_key
BUNNY_CDN_HOSTNAME=your_cdn_hostname.b-cdn.net

# Gemini AI (https://makersuite.google.com/app/apikey dan oling)
GEMINI_API_KEY=your_gemini_api_key

# CORS (production uchun, vergul bilan ajrating)
# ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Test telefon raqami (faqat development uchun, OTP rate limit bypass)
# TEST_PHONE=+998901234567
