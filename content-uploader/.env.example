# =================================
# Content Uploader - Environment Variables
# =================================
# Bu faylni .env deb nomlang va qiymatlarni to'ldiring
# cp .env.example .env

# MongoDB (qadamcha-backend bilan bir xil bo'lishi mumkin)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/qadamcha?retryWrites=true&w=majority

# Server port
PORT=4000

# Bunny.net (https://bunny.net dan oling)
BUNNY_LIBRARY_ID=your_library_id
BUNNY_API_KEY=your_bunny_api_key
BUNNY_CDN_HOST=your_cdn_hostname.b-cdn.net
