# Content Uploader - Environment Variables
# ==========================================

# MongoDB connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/qadamcha

# Server
PORT=4000

# Bunny.net Video CDN
BUNNY_LIBRARY_ID=your_library_id
BUNNY_API_KEY=your_api_key
BUNNY_CDN_HOST=your-cdn-host.b-cdn.net

# CORS (ajratilgan frontend uchun)
CORS_ORIGIN=http://localhost:3000
